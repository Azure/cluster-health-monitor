#!/fake-gpu-tools/busybox sh
set -eu

args=" $* "
for required in \
  " -i 10 " \
  " --format json "; do
  case "$args" in
    *"$required"*) ;;
    *) echo "missing expected nvbandwidth argument: $required; got:$args" >&2; exit 42 ;;
  esac
done

# Report only the testcases that were requested, as the real tool does.
testcases=""
add() {
  if [ -n "$testcases" ]; then testcases="$testcases,"; fi
  testcases="$testcases$1"
}
case "$args" in *" host_to_device_memcpy_ce "*)
  add '{"name":"host_to_device_memcpy_ce","status":"Passed","bandwidth_matrix":[["55","55","55","55","55","55","55","55"]]}' ;;
esac
case "$args" in *" device_to_host_memcpy_ce "*)
  add '{"name":"device_to_host_memcpy_ce","status":"Passed","bandwidth_matrix":[["55","55","55","55","55","55","55","55"]]}' ;;
esac
case "$args" in *" device_to_device_memcpy_read_ce "*)
  add '{"name":"device_to_device_memcpy_read_ce","status":"Passed","bandwidth_matrix":[
["N/A","395","395","395","395","395","395","395"],
["395","N/A","395","395","395","395","395","395"],
["395","395","N/A","395","395","395","395","395"],
["395","395","395","N/A","395","395","395","395"],
["395","395","395","395","N/A","395","395","395"],
["395","395","395","395","395","N/A","395","395"],
["395","395","395","395","395","395","N/A","395"],
["395","395","395","395","395","395","395","N/A"]]}' ;;
esac
if [ -z "$testcases" ]; then
  echo "no known nvbandwidth testcase requested; got:$args" >&2
  exit 42
fi

echo "{\"nvbandwidth\":{\"testcases\":[$testcases]}}"
